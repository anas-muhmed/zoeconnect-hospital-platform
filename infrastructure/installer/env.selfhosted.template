# HDSP Self-Hosted — Environment Template (Phase 12, Task 12.4)
#
# Copy to `.env` next to docker-compose.selfhosted.yml and fill in every
# CHANGE_ME value. install.sh does this for you interactively and will
# refuse to start the stack with any CHANGE_ME left in place.

# ── Release version to run (must exist as a GHCR tag -- see build-images.yml) ──
GHCR_OWNER=CHANGE_ME_your-github-org-or-user
HDSP_VERSION=CHANGE_ME_e.g._1.2.0

# ── Database ─────────────────────────────────────────────────────────────
DB_USER=hdsp_app
DB_PASSWORD=CHANGE_ME_generate_a_strong_password
DB_NAME=hdsp_db
DB_PORT=5432

# ── Redis ────────────────────────────────────────────────────────────────
REDIS_PORT=6379

# ── Auth (each must be a distinct, >=32-character random string) ──────────
JWT_SECRET=CHANGE_ME_32_char_minimum_random_string
JWT_REFRESH_SECRET=CHANGE_ME_different_32_char_minimum_random_string

# ── Deployment mode / provider selection (Phases 3-9's abstraction seam) ──
# Self-hosted defaults -- unless you know you need the cloud-mode
# equivalents, leave these as-is.
# Cloud Tenant Onboarding's VENDOR_PORTAL_API_KEY (see
# CLOUD_TENANT_ONBOARDING_DESIGN.md) is deliberately NOT listed here --
# it's required only when DEPLOYMENT_MODE=cloud (env.validation.ts), and
# self-hosted installs never expose TenantProvisioningController to a
# Vendor Portal cloud-provisioning caller in the first place. See
# CLOUD_DEPLOY.md Section 3 if you're setting up a cloud deployment
# instead of using this self-hosted installer.
DEPLOYMENT_MODE=self_hosted
STORAGE_DRIVER=local
LICENSE_PROVIDER_MODE=file
NOTIFICATION_PROVIDER_MODE=local
ORACLE_TRANSPORT=direct
PROCESS_ROLE=all

# ── Oracle HIS connection (direct mode -- leave blank if not integrating yet) ──
ORACLE_HOST=
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=
ORACLE_USER=
ORACLE_PASSWORD=

# ── Frontend ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# ── Initial tenant / hospital (used once by the reduced provisioning
#    pipeline install.sh runs on first start -- see PHASE_12_IMPLEMENTATION_PLAN.md) ──
INITIAL_HOSPITAL_NAME=CHANGE_ME_Your_Hospital_Name
INITIAL_ADMIN_USERNAME=CHANGE_ME_admin_username
INITIAL_ADMIN_EMAIL=CHANGE_ME_admin@example.com
INITIAL_ADMIN_PASSWORD=CHANGE_ME_strong_initial_password
