# ─────────────────────────────────────────────────────────────────
# ZoeConnect / HDSP Production Environment Template
# ─────────────────────────────────────────────────────────────────
# Copy this file to `/opt/hdsp/.env.production` before deployment.
# Replace all `<GENERATE_...>` placeholders with actual secrets.
#
# DO NOT add REGISTRY, IMAGE_NAMESPACE, or HDSP_VERSION here.
# The `deploy.sh` script automatically exports those during deployment.
# ─────────────────────────────────────────────────────────────────

#######################################
# GLOBAL
#######################################
NODE_ENV=production
PROCESS_ROLE=all
LOG_TO_STDOUT=true
LOG_LEVEL=info
LOG_DIR=/app/logs

# ZoeConnect Identity Migration
AUTH_IDENTITY_MODE=global
LOGIN_TENANT_SCOPE_MODE=shadow

# Throttling
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
LOGIN_THROTTLE_TTL=60000
LOGIN_THROTTLE_LIMIT=5

# License (Paths here must match the Docker volume mount /app/keys)
LICENSE_PUBLIC_KEY_PATH=/app/keys/license.public.pem
LICENSE_TRIAL_DAYS=7

# Billing (ZoeConnect Subscription & Payment Gateway) -- provider-agnostic
# knobs read by backend/src/config/billing.config.ts. PAYMENT_PROVIDER
# selects which PaymentProvider implementation is active; only 'razorpay'
# exists today.
PAYMENT_PROVIDER=razorpay
BILLING_CURRENCY=INR
BILLING_YEARLY_DISCOUNT_PERCENT=20
BILLING_TAX_PERCENT=18
BILLING_QUOTE_TTL_MINUTES=30

# Razorpay (required when PAYMENT_PROVIDER=razorpay). RAZORPAY_KEY_SECRET
# and RAZORPAY_WEBHOOK_SECRET are server-only -- never expose these to the
# frontend. RAZORPAY_KEY_ID is safe to expose (it's what Razorpay Checkout
# needs client-side).
RAZORPAY_KEY_ID=<FROM_RAZORPAY_DASHBOARD>
RAZORPAY_KEY_SECRET=<FROM_RAZORPAY_DASHBOARD>
# Set when configuring the webhook endpoint in the Razorpay dashboard
# (Settings > Webhooks), URL: https://<your-domain>/api/v1/billing/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=<GENERATE_IN_RAZORPAY_DASHBOARD>

#######################################
# DATABASE
#######################################
DB_HOST=hdsp-postgres
DB_PORT=5432
DB_NAME=hdsp_db
DB_USER=hdsp_app
# Generate with: openssl rand -hex 32
DB_PASSWORD=<GENERATE_32_CHAR_SECURE_PASSWORD>
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_LOGGING=false

#######################################
# REDIS
#######################################
REDIS_HOST=hdsp-redis
REDIS_PORT=6379
# Generate with: openssl rand -hex 32
REDIS_PASSWORD=<GENERATE_32_CHAR_SECURE_PASSWORD>
REDIS_DB=0
REDIS_CACHE_TTL=300

#######################################
# AUTH
#######################################
# Generate with: openssl rand -hex 64
JWT_SECRET=<GENERATE_64_CHAR_SECURE_PASSWORD>
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=<GENERATE_DIFFERENT_64_CHAR_SECURE_PASSWORD>
JWT_REFRESH_EXPIRES_IN=7d

#######################################
# HOSPITAL
#######################################
# Internal endpoints (Keep as Docker service names)
ZOECONNECT_BACKEND_URL=http://hdsp-backend:3001
ZOECONNECT_VENDOR_PORTAL_URL=http://vendor-backend:4000

# Reporting
POINT_VALUE_INR=0.25

# Oracle HIS (Optional - Leave blank unless explicitly required)
ORACLE_HOST=
ORACLE_PORT=1521
ORACLE_SERVICE=
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_POOL_MIN=2
ORACLE_POOL_MAX=20
ORACLE_POOL_INCREMENT=2
ORACLE_CONNECT_TIMEOUT=30
ORACLE_QUEUE_TIMEOUT=60000
ORACLE_MODE=thin

# HIS Real-time Sync
HIS_SYNC_INTERVAL_MS=10000
HIS_SYNC_LOOKBACK_DAYS=30

#######################################
# VENDOR
#######################################
VENDOR_DB_USER=vendor_app
VENDOR_DB_NAME=vendor_db
# Generate with: openssl rand -hex 32
VENDOR_DB_PASS=<GENERATE_32_CHAR_SECURE_PASSWORD>

# Generate with: openssl rand -hex 64
VENDOR_JWT_SECRET=<GENERATE_64_CHAR_SECURE_PASSWORD>
DEFAULT_ADMIN_PASSWORD=<CHANGE_THIS_ON_FIRST_LOGIN>

VENDOR_HDSP_BACKEND_URL=http://hdsp-backend:3001

# Cloud Tenant Onboarding (Vendor Portal to HDSP)
# CRITICAL FIX (401 on /api/public/signup/register, 2026-08): this file
# previously listed VENDOR_HDSP_PROVISIONING_API_KEY paired with
# PROVISIONING_SECRET under a "place it identically in both places" comment
# -- that pairing was WRONG. PROVISIONING_SECRET is a completely different,
# unrelated secret (see backend/src/modules/licensing/license.controller.ts's
# internal-provision endpoint) -- it is NOT read by
# VendorPortalApiKeyGuard (backend/src/modules/platform/tenant-provisioning/
# guards/vendor-portal-api-key.guard.ts), which instead reads
# VENDOR_PORTAL_API_KEY (see backend/src/config/deployment.config.ts:20,
# required when DEPLOYMENT_MODE=cloud per backend/src/config/
# env.validation.ts:58). Because VENDOR_PORTAL_API_KEY was never defined in
# this template at all, any .env.production generated from it left the HDSP
# backend's copy of the shared secret empty -- the guard's `configuredKey.
# length > 0` check then failed and silently fell through to JwtAuthGuard,
# which correctly rejects vendor-backend's unauthenticated service-to-
# service call with exactly the observed
# `401 {"message":"Authentication required"}` on both
# /api/v1/platform/tenant-provisioning/check-availability and
# /api/v1/platform/tenant-provisioning -- breaking the entire public
# self-signup "Create Workspace" flow.
#
# The two vars below MUST be set to the exact same value (constant-time
# compared by VendorPortalApiKeyGuard) -- see DEPLOYMENT_CHECKLIST.md's
# own (already-correct) line on this pairing. Generate ONE secret and use
# it for both:
#   openssl rand -hex 32
VENDOR_HDSP_PROVISIONING_API_KEY=<GENERATE_32_CHAR_SHARED_SECRET>
VENDOR_PORTAL_API_KEY=<SAME_VALUE_AS_VENDOR_HDSP_PROVISIONING_API_KEY_ABOVE>

# Internal license-provisioning secret (backend/src/modules/licensing/
# license.controller.ts's internal-provision endpoint) -- UNRELATED to the
# Cloud Tenant Onboarding secret pair above; do not reuse the same value.
PROVISIONING_SECRET=<GENERATE_32_CHAR_SECRET>

#######################################
# SELF HOSTED ONLY
#######################################
# DEPLOYMENT_MODE must be self_hosted (or omitted) for self-hosted mode.
# DEPLOYMENT_MODE=self_hosted

# Fallback Frontend routing when deployed locally or without a custom domain
# FRONTEND_URL=http://localhost:3000
# NEXT_PUBLIC_API_URL=http://localhost:3000/api

#######################################
# CLOUD ONLY
#######################################
# Set to 'cloud' to enable the Marketing Site, Subdomains, and Cloud Compose Override
DEPLOYMENT_MODE=cloud

CLOUD_BASE_DOMAIN=zoeconnect.in
FRONTEND_URL=https://app.zoeconnect.in
NEXT_PUBLIC_API_URL=https://app.zoeconnect.in/api

# Required by the Marketing Site (zoeconnect) to redirect users to Hospital Dashboard
NEXT_PUBLIC_APP_URL=https://app.zoeconnect.in

# Vendor Subdomains
VENDOR_CORS_ORIGIN=https://vendor.zoeconnect.in
VENDOR_NEXT_PUBLIC_API_URL=https://vendor.zoeconnect.in/api
