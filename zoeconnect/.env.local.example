# Real auth wiring to the ZoeConnect application (see src/lib/auth-config.ts
# and src/components/sign-in-form.tsx). Defaults below match a typical local
# dev setup where the app runs on :3000 and its backend on :3001.

# Backend the sign-in form's /api/* rewrite proxies to (see next.config.mjs).
# Same convention as the main application's own BACKEND_URL.
BACKEND_URL=http://localhost:3001

# Where a successful sign-in redirects to (the real app's dashboard).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Vendor Portal backend the /sign-up form's /vendor-api/* rewrite proxies to
# (see next.config.mjs) -- OTP request/verify + self-service tenant
# provisioning (public-signup module). Default matches vendor-portal/backend's
# own default PORT.
VENDOR_PORTAL_URL=http://localhost:4000
