# ─────────────────────────────────────────────────────────────────
# HDSP Backend — Environment Configuration
# Copy this file to .env and fill in all values before starting
# NEVER commit .env to version control
# ─────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
API_PREFIX=api
API_VERSION=v1
APP_NAME=HDSP
# Single source of truth for cloud vs self-hosted behavior across the
# entire stack. Must be lowercase 'cloud' or 'self_hosted'
# (env.validation.ts). Read directly here only by deployment.config.ts --
# every other backend module, and the frontend (via GET /license/status,
# which surfaces LicenseService.getDeploymentMode()'s value at runtime),
# reads it from there. Do not add a second, separately-set copy of this
# value anywhere else (e.g. a frontend-only env var) -- that duplication
# is exactly what caused a real cross-tenant UI bug when the two copies
# drifted out of sync.
DEPLOYMENT_MODE=cloud
PROVISIONING_SECRET=CHANGE_ME_STRONG_SECRET

# ZoeConnect Identity Architecture Migration -- must be 'global' on every
# deployment that has completed this migration (Phase 3/6/7). 'global' makes
# login resolve a user by a single, case-insensitive username-or-email
# lookup with no tenant/Host/subdomain involvement whatsoever -- the actual
# end state this whole migration exists to reach. Leaving this unset
# (defaults to 'legacy') is a real, confirmed incident: with
# LOGIN_TENANT_SCOPE_MODE also left at (or defaulted from an older
# deployment to) 'enforced', login requires an exact (username, tenantId)
# match where tenantId comes from SubdomainTenantMiddleware's Host-header
# resolution -- but Phase 6 removed subdomains entirely, so that middleware
# can never again resolve a real tenant from Host and always falls back to
# the seeded 'default' tenant's id, which never matches a provisioned
# admin's own tenantId. Result: every freshly provisioned cloud tenant's
# admin account gets a "temporary password" that can never actually log in,
# with a bare 401 "Invalid username or password" and no further clue in the
# logs (confirmed 2026-07-30 against a real CUTIS provisioning). Valid
# values: legacy | global.
AUTH_IDENTITY_MODE=global
# Legacy, pre-identity-migration rollout flag (Task 8.3) -- a no-op on any
# deployment with AUTH_IDENTITY_MODE=global above, since that mode is
# checked first and bypasses this entirely. Do not set this to 'enforced'
# on a deployment that has removed subdomains (Phase 6) unless
# AUTH_IDENTITY_MODE=global is also set -- see that variable's comment for
# why the combination of 'enforced' + no subdomains + AUTH_IDENTITY_MODE
# left at its 'legacy' default breaks every login. Valid values:
# legacy | shadow | enforced.
LOGIN_TENANT_SCOPE_MODE=shadow

# Allow Cloud Tenants to Submit License Requests -- base URL of the Vendor
# Portal's own API. Required for VendorSyncService.submitRequest() to reach
# the Vendor Portal for real when a cloud tenant's VendorRegistration.vendorApiUrl
# is the internal 'internal://vendor-portal' placeholder (see that field's
# doc comment) rather than a real, externally-registered vendor URL. Unset
# in self-hosted deployments -- they always have a real vendorApiUrl from
# their own register() call and never take this code path at all.
VENDOR_PORTAL_URL=http://localhost:4000

# ── PostgreSQL ────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hdsp_db
DB_USER=hdsp_app
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_LOGGING=false

# ── Oracle HIS ────────────────────────────────────────────────────
# Obtain these from your HIS vendor / hospital IT
ORACLE_HOST=192.168.1.100
ORACLE_PORT=1521
ORACLE_SERVICE=HISDB
ORACLE_USER=HDSP_READONLY
ORACLE_PASSWORD=CHANGE_ME_ORACLE_PASSWORD
ORACLE_POOL_MIN=2
ORACLE_POOL_MAX=20
ORACLE_POOL_INCREMENT=2
ORACLE_CONNECT_TIMEOUT=30
ORACLE_QUEUE_TIMEOUT=60000
# Set to thick for Oracle 11g/12c; thin for Oracle 19c+ (no client needed)
ORACLE_MODE=thick
# Path to Oracle Instant Client (required for thick mode)
ORACLE_INSTANT_CLIENT_PATH=/opt/oracle/instantclient

# ── Redis ─────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_DB=0
REDIS_CACHE_TTL=300

# ── JWT ───────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_64_CHAR_HEX_STRING
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_64_CHAR_HEX_STRING
JWT_REFRESH_EXPIRES_IN=7d

# ── License ───────────────────────────────────────────────────────
# RSA public key path (PEM format) — private key stays with vendor OFFLINE
LICENSE_PUBLIC_KEY_PATH=./keys/license.public.pem
LICENSE_TRIAL_DAYS=7

# ── Billing (ZoeConnect Subscription & Payment Gateway) ─────────────
PAYMENT_PROVIDER=razorpay
BILLING_CURRENCY=INR
BILLING_YEARLY_DISCOUNT_PERCENT=20
BILLING_TAX_PERCENT=18
BILLING_QUOTE_TTL_MINUTES=30
# Test-mode keys from the Razorpay dashboard (Settings > API Keys).
# RAZORPAY_KEY_SECRET/RAZORPAY_WEBHOOK_SECRET are server-only.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=CHANGE_ME
# Settings > Webhooks in the Razorpay dashboard; for local dev, use a
# tunnel (ngrok/cloudflared) pointed at POST /api/v1/billing/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=CHANGE_ME

# ── Throttling ────────────────────────────────────────────────────
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
LOGIN_THROTTLE_TTL=60000
LOGIN_THROTTLE_LIMIT=5

# ── WhatsApp ─────────────────────────────────────────────────────
# Meta WhatsApp Business API
WHATSAPP_API_URL=https://graph.facebook.com/v19.0
WHATSAPP_PHONE_NUMBER_ID=CHANGE_ME
WHATSAPP_ACCESS_TOKEN=CHANGE_ME
WHATSAPP_ENABLED=false

# ── HIS Real-time Sync ───────────────────────────────────────────
# How often to poll Oracle for new finalized bills (milliseconds)
# 10000 = 10 seconds (recommended). Increase on slow hospital LANs.
HIS_SYNC_INTERVAL_MS=10000

# How many days back to start processing bills on first boot (before any cursor exists).
# 30 = process the last 30 days of bills on first startup.
# Set to 0 to only process bills created after the app first starts.
HIS_SYNC_LOOKBACK_DAYS=30

# ── Reporting ────────────────────────────────────────────────────
# INR monetary value of 1 loyalty point (used for liability calculation)
POINT_VALUE_INR=0.25

# ── Logging ───────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_DIR=./logs
