# ── Vendor Portal Environment ──────────────────────────────────────────────────
# Copy this to .env and fill in real values before running docker-compose up

# JWT secret for vendor staff sessions — use a long random string
JWT_SECRET=change-this-to-a-random-64-char-string

# Default password for the auto-created admin account (change immediately after first login)
DEFAULT_ADMIN_PASSWORD=VendorAdmin@123

# Frontend URL — used for CORS allow-list on the backend
CORS_ORIGIN=http://localhost:3001

# URL the vendor frontend uses to call the backend API
# In production: set to your vendor server's IP/domain
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# ── Cloud Tenant Onboarding (see CLOUD_TENANT_ONBOARDING_DESIGN.md) ────────────
# Only needed if this Vendor Portal will provision cloud tenants against an
# HDSP cloud deployment (the "Provision Cloud Tenant" screen). Leave blank if
# you only manage self-hosted "Register to Vendor" hospitals — that existing
# flow does not use these.
#
# Base URL of the HDSP cloud backend to provision tenants against (no
# trailing slash) — the client calls POST {HDSP_BACKEND_URL}/api/v1/platform/tenant-provisioning
HDSP_BACKEND_URL=http://localhost:3001

# Must match HDSP's VENDOR_PORTAL_API_KEY exactly (same shared secret, see
# CLOUD_DEPLOY.md Section 3 / HDSP's VendorPortalApiKeyGuard) — sent as the
# X-Vendor-Portal-Api-Key header on every provisioning call.
HDSP_PROVISIONING_API_KEY=hdsp_vendorportal_dev_2026_4K8mP2xR9Lq7ZsWfA1Bc
